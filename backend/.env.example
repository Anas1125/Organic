# Copy to .env and fill in real values. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://YOUR_USER@localhost:5432/terralens_marketplace
TEST_DATABASE_URL=postgresql+psycopg://YOUR_USER@localhost:5432/terralens_marketplace_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173

# local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
PUBLIC_MEDIA_URL=/media
# Only needed when STORAGE_BACKEND=s3 (any S3-compatible service)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Used only by `python -m app.seed` to create the first admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Password for demo accounts created by `python -m app.seed --demo`
SEED_DEMO_PASSWORD=
