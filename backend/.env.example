# Copy to .env and fill in real values. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://YOUR_USER@localhost:5432/terralens_marketplace
TEST_DATABASE_URL=postgresql+psycopg://YOUR_USER@localhost:5432/terralens_marketplace_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173

# true on hosts without a shell (Vercel): run migrations + base seed on startup
AUTO_MIGRATE=false

# local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
PUBLIC_MEDIA_URL=/media
# Only needed when STORAGE_BACKEND=s3 (any S3-compatible service)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Used only by `python -m app.seed` to create the first admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Password for demo accounts created by `python -m app.seed --demo`
SEED_DEMO_PASSWORD=

# Links in emails point here
FRONTEND_URL=http://localhost:5173

# Email (https://resend.com). Without a key, emails are only written to the log.
RESEND_API_KEY=
# Until you verify your own domain in Resend, onboarding@resend.dev can only send to your Resend account email.
MAIL_FROM=Terralens <onboarding@resend.dev>
# Or send through Gmail (free, ~500/day, any recipient): use a Google app password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Email codes at sign-up and on new-device login (only active once email can reach anyone)
OTP_ON_SIGNUP=true
OTP_ON_LOGIN=true
OTP_EXEMPT_DOMAINS=example.com
# Daily order automation (Vercel Cron)
CRON_SECRET=

# Online payments (https://razorpay.com). Without keys, only cash on delivery is offered.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_WINDOW_MINUTES=30
